# =============================================================================
# Moltress — environment configuration
# Copy to `.env` (git-ignored) and adjust. Nothing here is a secret by default,
# and nothing points at a cloud service: the model runs locally via Ollama.
#
#   cp .env.example .env
#
# Read by the Python backend / agent layer AND (MOLTRESS_* keys only) by the
# Electron app. Real environment variables always override this file.
# =============================================================================

# --- Local LLM (Ollama) -------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# (Legacy names OLLAMA_HOST / MODEL_NAME from the original agent layer still work.)
# Local 7B models can be slow, especially on CPU: seconds per Ollama call.
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_NUM_RETRIES=2
MODEL_TEMPERATURE=0.2
MODEL_TOP_P=0.9
MODEL_MAX_TOKENS=2048
MODEL_JSON_MODE=true

# --- Backend (FastAPI) ---------------------------------------------------------
MOLTRESS_BACKEND_HOST=127.0.0.1
MOLTRESS_BACKEND_PORT=8765
# Optional shared secret. If set here, the Electron app sends it automatically.
# Leave empty for local-only use (the backend binds to 127.0.0.1 by default).
MOLTRESS_API_TOKEN=
# Only needed if a *browser* page (not the Electron app) calls the API.
MOLTRESS_CORS_ORIGINS=

# --- Desktop app -> backend -----------------------------------------------------
# "false" disables the Agent Layer and restores stock Hermes Desktop behaviour.
MOLTRESS_ENABLED=true
MOLTRESS_BACKEND_URL=http://127.0.0.1:8765
# Max time the UI waits for one agent answer (ms). Agents may call the model
# several times per request (tool loop), so keep this generous.
MOLTRESS_REQUEST_TIMEOUT_MS=600000

# --- Agent sandbox / tools -------------------------------------------------------
# Directory the agents may read. Empty = the repository root.
# The chat UI's "context folder" overrides it per request (see below).
MOLTRESS_PROJECT_ROOT=
MOLTRESS_ALLOW_CONTEXT_FOLDER=true
MOLTRESS_HISTORY_MAX_MESSAGES=12
MOLTRESS_VERIFICATION_ENABLED=true

# Dangerous capabilities are OFF by default. Only enable in trusted sandboxes.
ENABLE_TERMINAL_TOOL=false
ENABLE_TEST_EXECUTION=false
ENABLE_WRITE_TOOL=false
MAX_TOOL_ITERATIONS=6

# Optional retrieval/knowledge integrations of the agent layer.
RAG_ENABLED=false
GRAPH_ENABLED=false
MEMORY_ENABLED=false

LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Existing UI settings (unchanged)
# -----------------------------------------------------------------------------
# PostHog Analytics Configuration (optional)
# Set these in your build environment or CI to enable analytics
# These keys are NOT exposed to users - analytics only works in official builds
#
# GITHUB SECRETS SETUP:
#   1. Go to Settings → Secrets and variables → Actions
#   2. Add repository secrets:
#      - VITE_POSTHOG_KEY (optional) - Your PostHog project API key
#      - VITE_POSTHOG_HOST (optional) - PostHog API host (defaults to EU cloud)
#   3. These are automatically injected during GitHub Actions builds
#   4. Forks without these secrets will have analytics disabled
#
# Get your PostHog key: https://app.posthog.com/project/settings

VITE_POSTHOG_KEY=phc_your_project_key_here

# PostHog API Host (defaults to EU cloud: https://eu.i.posthog.com)
# Change this if you self-host PostHog or use US cloud
VITE_POSTHOG_HOST=https://us.i.posthog.com
