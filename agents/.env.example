# =============================================================================
# Moltress Agent Layer — Environment Configuration
# Copy this file to `.env` and adjust values as needed.
# Nothing here defaults to a cloud endpoint — everything is local-first.
#
# NOTE: when the agent layer runs inside the full Moltress application, use the
# repository-root `.env.example` instead (it covers the backend and UI too).
# =============================================================================

# --- Local LLM (Ollama) -----------------------------------------------------
# Preferred names (legacy OLLAMA_HOST / MODEL_NAME are still accepted):
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
MODEL_TEMPERATURE=0.2
MODEL_TOP_P=0.9
MODEL_MAX_TOKENS=2048
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_RETRIES=2
MODEL_JSON_MODE=true

# --- Tool sandbox ------------------------------------------------------------
# Absolute path to the project the agents are allowed to read/inspect.
# All file/code tools are restricted to this directory.
# Leave empty to default to the current working directory.
MOLTRESS_PROJECT_ROOT=

# Terminal execution is OFF by default. Only enable in trusted, isolated
# environments (e.g. a CI sandbox), never in a shared production process.
ENABLE_TERMINAL_TOOL=false
ALLOWED_TERMINAL_COMMANDS=pytest,python -m pytest,python -m pyflakes,python -m py_compile
TERMINAL_TIMEOUT_SECONDS=30

# Test execution (used by the Testing Agent's run_tests tool) is also OFF
# by default; requires ENABLE_TERMINAL_TOOL=true as well.
ENABLE_TEST_EXECUTION=false

MAX_FILE_READ_BYTES=200000
MAX_SEARCH_RESULTS=25

# The write_file tool is destructive and OFF by default. Even when enabled
# here, BaseAgent will still refuse to execute it unless the specific
# request explicitly approves it via AgentRequest.approved_actions.
# Only DeveloperAgent lists write_file in its tool permissions.
ENABLE_WRITE_TOOL=false

# Outer wall-clock timeout BaseAgent enforces around every tool call,
# independent of any timeout a tool manages internally.
TOOL_CALL_TIMEOUT_SECONDS=30

# --- Controlled autonomy (tool-use loop) ------------------------------------
# Hard ceiling on how many LLM turns / tool calls a single agent.run() may
# take before it is forced to stop and return a partial, explained result.
MAX_TOOL_ITERATIONS=6

# If the same tool fails (or is denied approval) this many times in a row,
# the loop stops early instead of retrying indefinitely.
MAX_CONSECUTIVE_TOOL_FAILURES=2

# --- Logging -------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=
LOG_REDACT_PAYLOADS=true

# --- Forward-looking integration flags (RAG / Graph / Memory) --------------
# When true AND a real provider instance is passed into an agent/router
# (see agents/providers.py), the agent auto-populates AgentContext before
# each run. With no provider (or false), this is a no-op — the agent layer
# works standalone either way.
RAG_ENABLED=false
GRAPH_ENABLED=false
MEMORY_ENABLED=false

# --- Global allow-lists (optional; comma-separated) -------------------------
# Restrict which agents/tools are available process-wide, e.g. for a
# locked-down demo/CI profile. Leave unset for "no additional restriction".
# ENABLED_AGENTS=developer_agent,debugging_agent,testing_agent,security_agent,documentation_agent
# ENABLED_TOOLS=read_file,search_code,inspect_project,inspect_source
